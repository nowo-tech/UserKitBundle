{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig).
    This file only declares the demo (nowo_ui_demo_platform); nowo_ui_kit.layouts.admin / guest point here, so "My
    sessions" and the session administration (UiKit page contract, REQ-UI-003) render inside the same shell. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _demo_nav = app.user
    ? [{label: 'Home', route: 'demo_home'}, {label: 'My sessions', route: 'nowo_user_kit_sessions', section: 'Account', testid: 'demo-nav-sessions'}]
    : [{label: 'Home', route: 'demo_home'}] %}
{% set nowo_ui_demo_platform = {
    bundle: 'User Kit',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/UserKitBundle',
    translation_domain: false,
    auth: {login_route: 'demo_login', logout_route: 'demo_logout'},
    nav: _demo_nav,
} %}
{% block nowo_ui_document_title %}{% block title %}User Kit Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
