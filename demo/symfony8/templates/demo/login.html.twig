{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Demo login'}) }}
{% endblock %}

{% block body %}
    {% if error %}
        <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
                {{ form_rest(form) }}
            {{ form_end(form, {render_rest: false}) }}
            <p class="nowo-ui-muted">Demo credentials: <code>demo@user-kit.test</code> / <code>demo</code></p>
        </div>
    </section>
{% endblock %}
