{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Demo login', intro: 'Sign in with the demo user to see the account status, presence and the session registry.'}) }}
{% endblock %}

{#- A failed sign-in is the shell's error flash, under the page header. -#}
{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: error ? {error: [error.messageKey|trans(error.messageData, 'security')]} : null}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Credentials', kind: 'form', intro: 'Demo credentials: demo@user-kit.test / demo', form: form} %}
        {% block section_body %}
            {{ form_start(form) }}
                {{ form_rest(form) }}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
