# Dependencies: installed by Composer inside the container, never committed.
/vendor

# Local environment: secrets and machine-specific values; .env.example is the committed template (REQ-DEMO-003).
.env
.env.local
.env.*.local
.env.dev

# Symfony runtime cache and logs: regenerated at boot (keep the .gitkeep placeholders).
/var/cache/*
/var/log/*
!/var/cache/.gitkeep
!/var/log/.gitkeep

# Test and coverage artifacts: produced locally / in CI only.
.phpunit.cache
.phpunit.result.cache
/coverage
coverage.xml

# IDE / OS files: personal editor and operating-system noise.
.idea
.vscode
*.swp
.DS_Store

# Symfony Flex managed block (kept so recipes stay idempotent).
###> symfony/framework-bundle ###
/.env.local
/.env.local.php
/.env.*.local
/config/secrets/prod/prod.decrypt.private.php
/public/bundles/
/var/
/vendor/
###< symfony/framework-bundle ###

# Archives / compressed: never part of the demo sources.
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# PHPUnit Flex managed block.
###> phpunit/phpunit ###
/phpunit.xml
/.phpunit.cache/
###< phpunit/phpunit ###

# SQLite artifacts (REQ-DEMO-011 — demos use MySQL)
*.db
*.sqlite
*.sqlite3
