# PHPStan configuration for User Kit Bundle
# Compatible with PHP 8.2+ and Symfony 7.x / 8.x

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    # REQ-CS-006: no silenced findings. ProfileRegistry and LastActivitySubscriber implement ResetInterface
    # (frankenphp.worker.noMissingResetInterface) instead of being ignored.
    ignoreErrors: []
    # 1.18.0 (Beacon spec 239): PhpStanFrankenPhp 1.4 worker load-readiness rules. Every UserKit write unit goes
    # through UserKit's own transaction runner.
    frankenphp:
        flagRollbackAfterNestedBegin: true
        flagFlushInHandWrittenTransaction: true
        flagUnboundedRecursion: true
        flagFlushWithoutClosedManagerRecovery: true

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  # Kernel reused (FRANKENPHP_RESET_KERNEL unset/false): worker + missing ResetInterface.
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-no-kernel-reset.neon
